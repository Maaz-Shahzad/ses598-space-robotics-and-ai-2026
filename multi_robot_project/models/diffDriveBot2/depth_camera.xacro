<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="red"><color rgba="1.0 0.0 0.0 1.0"/></material>

    <joint name="robot2_camera_joint" type="fixed">
        <parent link="robot2_base_link"/>
        <child link="robot2_camera_link"/>
        <origin xyz="0.255 0 0.05" rpy="0 0 0"/>
    </joint>

    <link name="robot2_camera_link">
        <visual>
            <geometry>
                <box size="0.010 0.03 0.03"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>


    <joint name="robot2_camera_optical_joint" type="fixed">
        <parent link="robot2_camera_link"/>
        <child link="robot2_camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="robot2_camera_link_optical"></link>


<!-- 
    <gazebo reference="robot2_camera_link">
        <material>Gazebo/Red</material>

        <sensor name="camera" type="depth">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <format>B8G8R8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
   
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <frame_name>robot2_camera_link_optical</frame_name>
                <min_depth>0.01</min_depth>
                <max_depth>20</max_depth>
            </plugin>

        </sensor>
    </gazebo>
-->
<gazebo reference="robot2_camera_link">
    <sensor name="camera" type="rgbd">
        <gz_frame_id>robot2_camera_link_optical</gz_frame_id>
        <topic>/robot2/camera/image_raw</topic>               
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image>
                <format>R8G8B8</format>
                <width>640</width>
                <height>480</height>
            </image>
            <clip>
                <near>0.05</near>
                <far>15.0</far>
            </clip>
        </camera>
        </sensor>
</gazebo>
</robot>
