    <include>
      <name>suv</name>
      <uri>model://suv</uri>
      <static>true</static>
      <pose>2 -9 0 0 0 -1.65</pose>
    </include>    
    <include>
      <name>stop_sign</name>
      <uri>model://stop_sign</uri>
      <static>true</static>
      <pose>-2 4 0 0 0 0.1</pose>
    </include>  

    <include>
      <name>prius_hybrid</name>
      <uri>model://prius_hybrid</uri>
      <static>true</static>
      <pose>0 8 0 0 0 0.15</pose>
    </include> 
    <include>
      <name>stop_sign2</name>
      <uri>model://stop_sign</uri>
      <static>true</static>
      <pose>-2 -4 0 0 0 0.1</pose>
    </include>  



    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

  </world>
</sdf>
